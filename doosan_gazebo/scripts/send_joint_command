#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from xbot_msgs.msg import JointCommand

class JointCommandPublisher(Node):
    def __init__(self):
        super().__init__('joint_command_publisher')
        self.publisher_ = self.create_publisher(JointCommand, '/xbotcore/command', 10)
        self.timer = self.create_timer(0.01, self.publish_joint_command)  # Publish every second
        self.get_logger().info('JointCommandPublisher node has been started.')

    def publish_joint_command(self):
        msg = JointCommand()
        msg.name = ['joint_1', 'joint_2', 'joint_3', 'joint_4', 'joint_5', 'joint_6']  # Example joint names
        msg.position = []  # Example positions
        msg.velocity = []  # Example velocities
        msg.effort = [0.0, 205.0, 0.0, 0.0, 0.0, 0.0]    # Example efforts
        msg.stiffness = []  # Example stiffnesses
        msg.damping = []  # Example dampings
        msg.ctrl_mode = [31, 31, 31, 31, 31, 31]
        self.publisher_.publish(msg)
        self.get_logger().info(f'Published JointCommand: {msg}')

def main(args=None):
    rclpy.init(args=args)
    node = JointCommandPublisher()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()