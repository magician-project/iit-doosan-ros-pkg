<?xml version="1.0"?>
<!-- Main doosan h2515 xacro. All doosan files are copy pasted in this repo with modification to remove ros control and gazebo plugins stuff,
    since xbot will be used -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="h2515" >

  <xacro:arg name="color"   default="blue"/>
  <xacro:arg name="gripper" default="none"/>
  <xacro:arg name="setup" default="none"/>
  <xacro:arg name="namespace" default=""/>
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="table" default="false"/>
  
  <xacro:property name="cr" value="$(arg color)"/>
  <xacro:property name="gr" value="$(arg gripper)"/>
  <xacro:property name="gz" value="$(arg use_gazebo)"/>
  <xacro:property name="stp" value="$(arg setup)"/>
  
  <xacro:if value="${cr == 'white'}">
    <xacro:include filename="$(find doosan_urdf)/urdf/macro.h2515.white.xacro" />
  </xacro:if>
  <xacro:if value="${cr == 'blue'}">
    <xacro:include filename="$(find doosan_urdf)/urdf/macro.h2515.blue.xacro" />
  </xacro:if>
  <xacro:h2515 namespace="$(arg namespace)"/>

  <!-- END EFFECTOR options -->
  <xacro:if value="${gr == 'none'}">
    <joint name = "tcp_joint" type="fixed">
      <parent link="link_6"/>
      <child link="tcp"/>
      <origin rpy = "0 0 0" xyz = "0 0 0" />
    </joint>
  </xacro:if>
  <xacro:if value="${gr == 'dewalt'}">
    <xacro:include filename="$(find doosan_urdf)/urdf/macro.tool.xacro" />
    <xacro:dewalt/>
    <joint name = "tcp_joint" type="fixed">
      <parent link="tool_link"/>
      <child link="tcp"/>
      <origin rpy = "0 0 1.571" xyz = "0 0 0.17872" />
    </joint>
  </xacro:if>
  <xacro:if value="${gr == 'tactile'}">
    <xacro:include filename="$(find doosan_urdf)/urdf/tactile_sensor.xacro" />
    <xacro:tactile_sensor/>
    <joint name = "tcp_joint" type="fixed">
      <parent link="tactile_sensor_link"/>
      <child link="tcp"/>
      <origin rpy = "1.57 0 0" xyz = "0 -0.026 0" />
    </joint>
  </xacro:if>
  <link name = "tcp"></link>

  <link name="world"/>

  <xacro:if value="${stp == 'none'}">
    <joint name="world_fixed" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="world"/>
      <child link="base_link"/>
    </joint>
  </xacro:if>
  <xacro:if value="${stp == 'iit'}">
    <xacro:include filename="$(find doosan_urdf)/urdf/iit_table.urdf.xacro" />
    <joint name="world_fixed" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="world"/>
      <child link="ironplate_reference"/>
    </joint>
    <joint name="table_to_base" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
      <parent link="ironplate_reference"/>
      <child link="base_link"/>
    </joint>
  </xacro:if>


</robot>

