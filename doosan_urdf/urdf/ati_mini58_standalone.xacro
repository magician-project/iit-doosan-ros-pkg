<?xml version="1.0"?>
<!-- This is the file for the Grinding tool that will be attached on to the doosan -->
<robot name="ati_mini58" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Define the tool macro -->
    <xacro:macro name="ati_mini58" params="parent name:=ati_mini58 mass=0.345 radius:=0.029 height:=0.030">
        <!--tool_joint-->
        <joint name = "${name}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${name}_link"/>
            <!-- We mount it upside down -->
            <origin xyz="0 0 ${height/2}" rpy="3.14159265359 0 0"/> 
        </joint>
        <link name = "${name}_link">
            <inertial>
                <mass value="${mass}"/>
                <origin xyz="0 0 0" rpy="0 0 0"/> 
                <inertia
                    ixx="${0.083 * mass * (3*radius*radius+(height*height))}" ixy="0.0"  ixz="0.0" 
                    iyy="${0.083 * mass * (3*radius*radius+(height*height))}" iyz="0.0" 
                    izz="${0.5 * mass * radius * radius}" />
            </inertial>     
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/> 
                <!-- <geometry>
                    <mesh filename="package://doosan_urdf/meshes/ati_sensors/ATI-9105-TW-Mini58-E-X_X.stl"/>
                </geometry> -->
                <geometry>
                    <cylinder length="${height}" radius="${radius}"/>
                </geometry> 
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <cylinder length="${height}" radius="${radius}"/>
                </geometry> 
            </collision>		
        </link>
        <joint name = "${name}_sensing_frame_joint" type="fixed">
            <parent link="${name}_link"/>
            <child link="${name}_sensing_frame"/>
            <origin rpy = "0 0 0" xyz = "0 0 ${height/2}" />
        </joint>
        <link name = "${name}_sensing_frame"></link>
    </xacro:macro>
</robot>