<?xml version="1.0"?>
<!-- This is the file for the Grinding tool that will be attached on to the doosan -->
<robot name="dewalt_ft" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Define the tool macro -->
    <xacro:macro name="dewalt_ft">
        <!--tool_joint-->
        <joint name = "dewalt_ft_joint" type="fixed">
            <parent link="link_6"/>
            <child link="dewalt_ft_link"/>
            <origin rpy = "0 0 -1.571" xyz = "0 0 0" />
        </joint>
        <link name = "dewalt_ft_link">
            <inertial>
                <!--<mass value="2.283"/> --> <!-- sriram model -->
                <mass value="3.28"/> <!-- doosan estimation utility -->
                <origin xyz="-0.027197381 -0.00048674567 0.082216345"/>
                <inertia ixx="0.00916146" ixy="-0.00007365" ixz="0.00147785" 
                            iyy="0.01315032" iyz="0.00002495" izz="0.00824114"/>
                <!--inertia ixx="0.02459" ixy="-0.0001038816" ixz="0.00658395" 
                            iyy="0.030274954" iyz="0.0001163363" izz="0.0099307971"/-->
            </inertial>     
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://doosan_urdf/meshes/h2515_grinding_tool_collision/doosan_tool_attachment.dae" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://doosan_urdf/meshes/h2515_grinding_tool/doosan_tool_attachment.dae" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name = "yellow">
                    <color rgba = "1.0 0.92 0.016 1.0"/>       
                </material>  
            </visual>		
        </link>
        <joint name = "tcp_joint" type="fixed">
            <parent link="dewalt_ft_link"/>
            <child link="tcp"/>
            <origin rpy = "0 0 1.571" xyz = "0 0 0.17872" />
        </joint>
        <link name = "tcp"></link>
        <joint name = "dewalt_ft_sensing_frame_joint" type="fixed">
            <parent link="dewalt_ft_link"/>
            <child link="ft_sensing_frame"/>
            <!-- Sensor is upside down -->
            <!-- <origin rpy = "3.14159265359 0 0" xyz = "0 0 0.02" /> -->
            <origin rpy = "0.0 0 0.785" xyz = "0 0 0.02" />

        </joint>
        <link name = "ft_sensing_frame"></link>
    </xacro:macro>
</robot>