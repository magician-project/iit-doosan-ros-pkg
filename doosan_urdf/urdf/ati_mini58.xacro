<?xml version="1.0"?>
<!-- This is the file for the Grinding tool that will be attached on to the doosan -->
<robot name="ati_mini58" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Define the tool macro -->
    <xacro:macro name="ati_mini58" params="parent name:=ati_mini58">
        <!--tool_joint-->
        <joint name = "${name}_joint" type="fixed">
            <parent link="${parent}"/>
            <child link="${name}_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/> 
        </joint>
        <link name = "${name}_link">
            <inertial>
                <mass value="0.62"/>
                <origin xyz="0 0 0" rpy="0 0 0"/> 
                <inertia
                    ixx="0.0007350993" ixy="-0.000000040447"  ixz="0.000000437801" 
                    iyy="0.0007321633" iyz="0.00000027" 
                    izz="0.0008609344" />
            </inertial>     
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find doosan_urdf)/meshes/ati_sensors/ati_mini58_with_flange.dae" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find doosan_urdf)/meshes/ati_sensors/ati_mini58_with_flange.dae" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name = "${name}_silver">
                    <color rgba = "1.0 0.769 0.769 0.769"/>       
                </material>  
            </visual>			
        </link>
        <joint name = "tcp_joint" type="fixed">
            <parent link="${name}_link"/>
            <child link="tcp"/>
            <origin rpy = "0 0 0" xyz = "0 0 0.050" />
            </joint>
        <link name = "tcp"></link>
        <joint name = "${name}_sensing_frame_joint" type="fixed">
            <parent link="${name}_link"/>
            <child link="ft_sensing_frame"/>
            <origin rpy = "3.14159265359 0 0" xyz = "0 0 0.02" />
        </joint>
        <link name = "ft_sensing_frame"></link>
    </xacro:macro>
</robot>