<?xml version="1.0"?>
<!-- This is the file for the Grinding tool that will be attached on to the doosan -->
<robot name="dewalt" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Define the tool macro -->
    <xacro:macro name="dewalt">
        <!--tool_joint-->
        <joint name = "tool_joint" type="fixed">
            <parent link="link_6"/>
            <child link="tool_link"/>
            <origin rpy = "0 0 -1.571" xyz = "0 0 0" />
        </joint>
        <link name = "tool_link">
            <inertial>
                <mass value="2.283"/>
                <origin xyz="-0.027197381 -0.00048674567 0.082216345"/>
                <inertia ixx="0.00916146" ixy="-0.00007365" ixz="0.00147785" 
                            iyy="0.01315032" iyz="0.00002495" izz="0.00824114"/>
                <!--inertia ixx="0.02459" ixy="-0.0001038816" ixz="0.00658395" 
                            iyy="0.030274954" iyz="0.0001163363" izz="0.0099307971"/-->
            </inertial>     
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find doosan_urdf)/meshes/h2515_grinding_tool_collision/doosan_tool_attachment.dae" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find doosan_urdf)/meshes/h2515_grinding_tool/doosan_tool_attachment.dae" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name = "yellow">
                    <color rgba = "1.0 0.92 0.016 1.0"/>       
                </material>  
            </visual>		
        </link>
    </xacro:macro>
</robot>